{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Xindoze",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "center": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../../genomes/": "genomes/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
